# Host port the API is exposed on (port 8000 is already used on this machine)
ICD_PORT=8382

# ICD-11 release + languages to load. Examples:
#   2026-01_en            English only (default, latest)
#   2026-01_en-es-fr      English, Spanish, French
#   2026-01_en,2025-01_en two consecutive releases
# Changing this requires recreating the container (needs internet once).
ICD_INCLUDE=2026-01_en

# false = no search analytics sent to WHO
ICD_SAVE_ANALYTICS=false

# Optional features
ICD_ENABLE_DORIS=false
ICD_FHIR_SUPPORT=false
